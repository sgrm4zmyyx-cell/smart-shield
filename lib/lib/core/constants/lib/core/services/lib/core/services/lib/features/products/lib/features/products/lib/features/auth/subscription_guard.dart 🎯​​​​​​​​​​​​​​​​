enum SubscriptionStatus {
  active,
  trial,
  expired,
  subscriptionExpired,
}

class SubscriptionGuard {
  final LocalStorageService _local;

  SubscriptionGuard(this._local);

  SubscriptionStatus checkStatus() {
    final isVip = _local.getIsVip();
    final registrationDate = _local.getRegistrationDate();
    final subscriptionExpiry = _local.getSubscriptionExpiry();

    if (isVip && subscriptionExpiry != null) {
      if (DateTime.now().isBefore(subscriptionExpiry)) {
        return SubscriptionStatus.active;
      } else {
        return SubscriptionStatus.subscriptionExpired;
      }
    }

    if (registrationDate != null) {
      final daysSinceRegistration =
          DateTime.now().difference(registrationDate).inDays;
      if (daysSinceRegistration <= 7) {
        return SubscriptionStatus.trial;
      } else {
        return SubscriptionStatus.expired;
      }
    }

    _local.saveUserData({'registrationDate': DateTime.now().toIso8601String()});
    return SubscriptionStatus.trial;
  }

  bool get canAccessPremiumFeatures {
    return checkStatus() == SubscriptionStatus.active;
  }
}

